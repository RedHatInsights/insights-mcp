{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>konflux-ci/mintmaker//config/renovate/renovate.json",
        "schedule:earlyMondays"
    ],
    "baseBranchPatterns": [
        "main"
    ],
    "timezone": "Europe/Prague",
    "automerge": true,
    "tekton": {
        "automerge": true,
        "automergeStrategy": "rebase",
        "automergeType": "pr",
        "enabled": true,
        "platformAutomerge": true
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Pin mcp-publisher release + linux/amd64 asset digest",
            "managerFilePatterns": [
                "/^\\.github/workflows/publish-mcp\\.yaml$/"
            ],
            "matchStrings": [
                "MCP_PUBLISHER_VERSION:\\s*v(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s+MCP_PUBLISHER_SHA256:\\s*(?<currentDigest>[a-f0-9]{64})"
            ],
            "depNameTemplate": "modelcontextprotocol/registry",
            "datasourceTemplate": "github-release-attachments",
            "extractVersionTemplate": "^v(?<version>.*)$",
            "packageNameTemplate": "modelcontextprotocol/registry"
        },
        {
            "customType": "regex",
            "description": "Pin mermaid-cli container image used to render architecture diagrams",
            "managerFilePatterns": [
                "/^scripts\\/generate_diagrams\\.py$/"
            ],
            "matchStrings": [
                "MERMAID_CLI_IMAGE\\s*=\\s*\"(?<depName>ghcr\\.io/[^\":]+):(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["ghcr.io/mermaid-js/mermaid-cli/mermaid-cli"],
            "automerge": false,
            "prBodyNotes": [
                "As the mermaid container reference was updated, please regenerate docs with `make generate-docs` before merging. This needs to be done manually as we need signed commits."
            ]
        }
    ]
}
